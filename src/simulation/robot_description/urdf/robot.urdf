<?xml version="1.0"?>
<robot name="tank_bot">

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <box size="0.32 0.23 0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <box size="0.32 0.23 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="4.5"/>
      <inertia
        ixx="0.05"
        ixy="0.0"
        ixz="0.0"
        iyy="0.09"
        iyz="0.0"
        izz="0.11"/>
    </inertial>
  </link>

  <!-- ================= LEFT TRACK (SIMPLIFIED WHEEL) ================= -->
  <link name="left_track">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.001"
        iyy="0.001"
        izz="0.001"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <joint name="left_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_track"/>
    <origin xyz="0 0.09 0.03"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= RIGHT TRACK (SIMPLIFIED WHEEL) ================= -->
  <link name="right_track">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.001"
        iyy="0.001"
        izz="0.001"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <joint name="right_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_track"/>
    <origin xyz="0 -0.09 0.03"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= GAZEBO FRICTION ================= -->
  <gazebo reference="left_track">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

  <gazebo reference="right_track">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

</robot>
